# Copier vers backend/.env (dev local ou prod sans Docker)

# Base SQLite (prod Docker : sqlite:////data/maintenance_reports.db)
DATABASE_URL=sqlite:///./maintenance_reports.db

# CORS — en prod avec Elastic IP :
# CORS_ORIGINS=http://203.0.113.42
CORS_ORIGINS=*

# LLM (Groq exemple)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b

# Ollama local (dev)
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2:latest
